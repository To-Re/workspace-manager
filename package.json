{
  "name": "workspace-manager",
  "displayName": "Workspace Shelf 工作区管理",
  "description": "一键保存当前窗口的文件、文件夹和工作区设置，命名并快速切换。",
  "publisher": "to-re",
  "version": "0.2.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository --out artifacts/workspace-manager-0.2.2.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "3.7.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "workspaceShelf.save",
        "title": "保存当前窗口：保存打开的文件、文件夹和工作区设置，无需另存为",
        "icon": "$(save)",
        "category": "工作区管理",
        "shortTitle": "保存当前窗口"
      },
      {
        "command": "workspaceShelf.pick",
        "title": "搜索工作区：按名称、主机或路径查找已保存的工作区",
        "icon": "$(search)",
        "category": "工作区管理",
        "shortTitle": "搜索工作区"
      },
      {
        "command": "workspaceShelf.refresh",
        "title": "刷新列表：读取其他窗口保存或修改的工作区",
        "icon": "$(refresh)",
        "category": "工作区管理",
        "shortTitle": "刷新列表"
      },
      {
        "command": "workspaceShelf.open",
        "title": "新窗口打开：保留当前窗口，打开此工作区并恢复文件标签",
        "icon": "$(go-to-file)",
        "category": "工作区管理",
        "shortTitle": "新窗口打开"
      },
      {
        "command": "workspaceShelf.reuse",
        "title": "当前窗口打开：在当前窗口切换到此工作区",
        "icon": "$(window)",
        "category": "工作区管理",
        "shortTitle": "当前窗口打开"
      },
      {
        "command": "workspaceShelf.rename",
        "title": "重命名：修改列表名称，下次打开时使用新的工作区名称",
        "icon": "$(edit)",
        "category": "工作区管理",
        "shortTitle": "重命名"
      },
      {
        "command": "workspaceShelf.remove",
        "title": "从列表移除：可撤销，不删除项目文件",
        "icon": "$(close)",
        "category": "工作区管理",
        "shortTitle": "从列表移除"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspaceShelf",
          "title": "工作区管理",
          "icon": "media/workspaces.svg"
        }
      ]
    },
    "views": {
      "workspaceShelf": [
        {
          "id": "workspaceShelf.list",
          "name": "工作区"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workspaceShelf.list",
        "contents": "保存当前窗口的文件和文件夹，下次一键打开。\n[保存当前窗口](command:workspaceShelf.save)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspaceShelf.save",
          "when": "view == workspaceShelf.list",
          "group": "navigation@0"
        },
        {
          "command": "workspaceShelf.pick",
          "when": "view == workspaceShelf.list",
          "group": "tools"
        },
        {
          "command": "workspaceShelf.refresh",
          "when": "view == workspaceShelf.list",
          "group": "tools"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceShelf.open",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "inline"
        },
        {
          "command": "workspaceShelf.reuse",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "manage@1"
        },
        {
          "command": "workspaceShelf.rename",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "inline@2"
        },
        {
          "command": "workspaceShelf.remove",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "manage@3"
        }
      ]
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
