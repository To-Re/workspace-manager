{
  "name": "workspace-manager",
  "displayName": "Workspace Shelf 工作区管理",
  "description": "一键保存当前窗口的文件、文件夹和工作区设置，命名并快速切换。",
  "publisher": "to-re",
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository --out artifacts/workspace-manager-0.2.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "3.7.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "workspaceShelf.save",
        "title": "工作区管理：保存当前窗口",
        "icon": "$(save)"
      },
      {
        "command": "workspaceShelf.pick",
        "title": "工作区管理：搜索工作区",
        "icon": "$(search)"
      },
      {
        "command": "workspaceShelf.refresh",
        "title": "工作区管理：刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceShelf.open",
        "title": "工作区管理：在新窗口打开",
        "icon": "$(go-to-file)"
      },
      {
        "command": "workspaceShelf.reuse",
        "title": "工作区管理：在当前窗口打开",
        "icon": "$(window)"
      },
      {
        "command": "workspaceShelf.rename",
        "title": "工作区管理：修改显示名称",
        "icon": "$(edit)"
      },
      {
        "command": "workspaceShelf.remove",
        "title": "工作区管理：从列表移除",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspaceShelf",
          "title": "工作区管理",
          "icon": "media/workspaces.svg"
        }
      ]
    },
    "views": {
      "workspaceShelf": [
        {
          "id": "workspaceShelf.list",
          "name": "工作区"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workspaceShelf.list",
        "contents": "保存当前窗口的文件和文件夹，下次一键打开。\n[保存当前窗口](command:workspaceShelf.save)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspaceShelf.save",
          "when": "view == workspaceShelf.list",
          "group": "navigation@0"
        },
        {
          "command": "workspaceShelf.pick",
          "when": "view == workspaceShelf.list",
          "group": "tools"
        },
        {
          "command": "workspaceShelf.refresh",
          "when": "view == workspaceShelf.list",
          "group": "tools"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceShelf.open",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "inline"
        },
        {
          "command": "workspaceShelf.reuse",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "manage@1"
        },
        {
          "command": "workspaceShelf.rename",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "inline@2"
        },
        {
          "command": "workspaceShelf.remove",
          "when": "view == workspaceShelf.list && viewItem == savedWorkspace",
          "group": "manage@3"
        }
      ]
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
